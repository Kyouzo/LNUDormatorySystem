# Copy to connection/.env (never commit the real file) or set real environment variables.
# Every value below is optional; the defaults suit a local XAMPP install.

DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASS=
DB_NAME=lnudormatorysystem
# MySQL session time zone, keeps NOW() in step with PHP
DB_TIMEZONE=+08:00
APP_TIMEZONE=Asia/Manila

# 0 = a CSRF token is checked only if the client sends one (default, lenient)
# 1 = every state-changing POST must carry a valid token (X-CSRF-Token header or csrf_token field)
CSRF_ENFORCE=0

# 1 = scanner also accepts the plain student ID inside the QR (legacy); default 0 = qr_token only.
QR_ALLOW_STUDENT_ID=0

# Idle logout in seconds (default 7200)
SESSION_IDLE_SECONDS=7200

# Rooms: capacity used when a room row has to be auto-created (the rooms table holds the real per-room value).
ROOM_CAPACITY=4

# Curfew: a curfew scan at or after CURFEW_TIME (HH:MM, 24 h) and before CURFEW_END the next morning is late.
CURFEW_TIME=22:00
CURFEW_END=04:00

# 1 = the entrance slip upload is mandatory on student registration (default 0: optional)
ENTRANCE_SLIP_REQUIRED=0
