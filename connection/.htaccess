# Internal PHP includes and secrets must not be requested directly.
# (csrf_token.php, me.php, announcements.php, notifications_seen.php and change_password.php
#  are public/authenticated endpoints and stay reachable.)
<FilesMatch "^(\.env.*|bootstrap\.php|db_connect\.php|auth\.php|csrf\.php|violation_types\.php|lib_[a-z_]+\.php)$">
    Require all denied
</FilesMatch>
